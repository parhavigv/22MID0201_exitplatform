# Copy to backend/.env and fill in once the Supabase project exists.
# The app boots without these and serves /health, so the skeleton is runnable.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Direct Postgres connection, used by scripts/apply_migrations.py and by the
# LangGraph checkpointer in Phase 3.
# Dashboard: Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER (port 5432) — transaction mode on 6543 cannot run all
# DDL, and the direct db.<ref>.supabase.co host is IPv6-only on new projects.
DATABASE_URL=

# Bypasses RLS. Used only by the executor, the sweep job, and audit writes.
# Never reaches a request handler or an agent tool.
SUPABASE_SERVICE_KEY=

# Set ONLY on projects still using the legacy shared HS256 secret.
# Leave empty on projects with asymmetric JWT signing keys — deps.py then
# verifies against the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# --- LLM (Phase 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set only when routing through a gateway. Empty = call Anthropic directly.
ANTHROPIC_BASE_URL=

# --- App ---
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
