# Serve every screen from src/lib/mock.ts. Set to false once the backend is up.
VITE_USE_MOCKS=true

# Backend base path. Vite proxies /api to http://127.0.0.1:8000 in dev.
VITE_API_BASE=/api

# Supabase — fill in once the project exists (Phase 0).
# The anon key is public by design; RLS is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
